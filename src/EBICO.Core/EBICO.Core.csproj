<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- NuGet package metadata (issue #50). Shared fields live in Directory.Build.props. -->
  <PropertyGroup>
    <Description>Shared EBICS primitives (schemas/serialisation, crypto, BTF and order models) — the common foundation of EBICO.Connector and the EBICO server emulator. Supports H003/H004/H005.</Description>
    <PackageTags>ebics;banking;sepa;iso20022;camt;pain;crypto;emulator</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    XML canonicalisation (C14N) for signatures (#15). Provides the BCL transforms
    XmlDsigC14NTransform / XmlDsigExcC14NTransform. Version centrally in Directory.Packages.props.
    RSA crypto goes through System.Security.Cryptography (framework, not a package) — see
    ADR-0008.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

</Project>
