@page "/schluessel"
@inject IEmulatorStateProvider State

<PageTitle>Keys</PageTitle>

<h1>Keys &amp; Certificates</h1>

<p class="text-muted">
    Public keys of the bank and subscribers (A00x/E002/X002) with their
    SHA-256 fingerprints, an INI-letter comparison and tools for generating
    test keys and certificates.
</p>

<h2>Known Keys &amp; Fingerprints</h2>
@if (_loading)
{
    <p><em>Loading keys…</em></p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Owner</th><th>Purpose</th><th>Version</th><th>Fingerprint (SHA-256)</th></tr>
        </thead>
        <tbody>
            @foreach (var key in _keys)
            {
                <tr>
                    <td>@key.OwnerLabel</td>
                    <td>@PurposeLabel(key.Purpose)</td>
                    <td>@key.KeyVersion</td>
                    <td><pre class="mb-0 fingerprint">@key.FingerprintText</pre></td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Key Versions (Reference)</h2>
<p class="text-muted">
    Which EBICS key version is allowed in which protocol version (H003/H004/H005)
    (source: <code>EBICO.Core.Crypto.KeyVersions</code>).
</p>
<table class="table">
    <thead>
        <tr><th>Code</th><th>Purpose</th><th>Legacy</th><th>Padding</th><th>Allowed in</th></tr>
    </thead>
    <tbody>
        @foreach (var info in KeyVersions.All)
        {
            <tr>
                <td>@info.Code</td>
                <td>@PurposeLabel(info.Purpose)</td>
                <td>@(info.IsLegacy ? "yes" : "no")</td>
                <td>@info.PaddingIntent</td>
                <td>@string.Join(", ", info.PermittedIn)</td>
            </tr>
        }
    </tbody>
</table>

<h2>INI-Letter Comparison</h2>
<IniLetterComparisonTool @rendermode="InteractiveServer" />

<h2>Test CA &amp; Key Tools</h2>
<TestKeyTool @rendermode="InteractiveServer" />

@code {
    private bool _loading = true;
    private IReadOnlyList<KeyView> _keys = [];

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _keys = await State.GetKeysAsync();
        _loading = false;
    }

    private static string PurposeLabel(KeyPurpose purpose) => purpose switch
    {
        KeyPurpose.Signature => "Signature (A)",
        KeyPurpose.Encryption => "Encryption (E)",
        KeyPurpose.Authentication => "Authentication (X)",
        _ => purpose.ToString(),
    };
}
