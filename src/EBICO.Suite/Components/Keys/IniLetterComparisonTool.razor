@inject IEmulatorStateProvider State

@*
    INI-letter comparison (issue #55): verifies a public-key fingerprint typed from an INI letter
    against a known key or a pasted public key, using PublicKeyFingerprint.Verify (constant time).
    Rendered as an interactive island; the render mode is applied at the embedding site.
*@

<p class="text-muted">
    Checks a fingerprint transcribed from the INI letter against a key — exactly the
    manual comparison the bank performs when an INI letter arrives.
</p>

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label" for="key-source">Key</label>
        <select id="key-source" class="form-select" @bind="_selectedIndex">
            @for (var i = 0; i < _keys.Count; i++)
            {
                var key = _keys[i];
                <option value="@i">@key.OwnerLabel — @key.KeyVersion</option>
            }
            <option value="-1">Paste public key (PEM)…</option>
        </select>

        @if (_selectedIndex < 0)
        {
            <textarea id="pasted-key" class="form-control mt-2" rows="6"
                      placeholder="-----BEGIN PUBLIC KEY-----" @bind="_pastedPem"></textarea>
        }
    </div>

    <div class="col-md-6">
        <label class="form-label" for="expected-fingerprint">Fingerprint from INI letter</label>
        <textarea id="expected-fingerprint" class="form-control fingerprint-input" rows="6"
                  placeholder="e.g. 1A 2B 3C …" @bind="_expected"></textarea>
    </div>
</div>

<button class="btn btn-primary mt-3" @onclick="Compare">Compare</button>

@switch (_result)
{
    case Outcome.Match:
        <div class="alert alert-success mt-3" role="alert">Fingerprint matches.</div>
        break;
    case Outcome.Mismatch:
        <div class="alert alert-danger mt-3" role="alert">
            Fingerprint does <strong>not</strong> match.
            @if (_actualFingerprint is not null)
            {
                <div class="mt-2">Actual fingerprint of the key:</div>
                <pre class="mb-0 fingerprint-input">@_actualFingerprint</pre>
            }
        </div>
        break;
    case Outcome.InvalidKey:
        <div class="alert alert-warning mt-3" role="alert">
            The pasted key could not be read (a PEM with an RSA public key is expected).
        </div>
        break;
    case Outcome.InvalidFingerprint:
        <div class="alert alert-warning mt-3" role="alert">
            The fingerprint could not be read as a hexadecimal value.
        </div>
        break;
    case Outcome.MissingFingerprint:
        <div class="alert alert-warning mt-3" role="alert">
            Please enter the fingerprint from the INI letter.
        </div>
        break;
}

@code {
    private IReadOnlyList<KeyView> _keys = [];
    private int _selectedIndex;
    private string _pastedPem = string.Empty;
    private string _expected = string.Empty;
    private Outcome _result = Outcome.None;
    private string? _actualFingerprint;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
        => _keys = await State.GetKeysAsync();

    private void Compare()
    {
        _actualFingerprint = null;

        // An empty field is "nothing typed yet", not "unreadable hex" — the tool exists for transcribing
        // a fingerprint off a letter, so the two cases need different guidance (issue #126).
        if (string.IsNullOrWhiteSpace(_expected))
        {
            _result = Outcome.MissingFingerprint;
            return;
        }

        if (!TryResolveKey(out var key))
        {
            _result = Outcome.InvalidKey;
            return;
        }

        if (!FingerprintFormat.TryParseHex(_expected, out var expectedDigest))
        {
            _result = Outcome.InvalidFingerprint;
            return;
        }

        var actualDigest = PublicKeyFingerprint.Compute(key);
        _actualFingerprint = PublicKeyFingerprint.ToLetterFormat(actualDigest);
        _result = PublicKeyFingerprint.Verify(key, expectedDigest) ? Outcome.Match : Outcome.Mismatch;
    }

    private bool TryResolveKey(out RsaKeyMaterial key)
    {
        if (_selectedIndex >= 0 && _selectedIndex < _keys.Count)
        {
            key = _keys[_selectedIndex].PublicKey;
            return true;
        }

        try
        {
            key = RsaKeyImportExport.ImportFromPem(_pastedPem);
            return true;
        }
        catch (KeyMaterialException)
        {
            key = null!;
            return false;
        }
    }

    private enum Outcome
    {
        None,
        Match,
        Mismatch,
        InvalidKey,
        InvalidFingerprint,
        MissingFingerprint,
    }
}
