<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <!--
    WebApplicationFactory<Program> needs the ASP.NET Core shared framework in the test project.
    It also supplies System.Security.Cryptography.Xml and Microsoft.Extensions.DependencyInjection
    (which are therefore no longer needed as their own PackageReference — NU1510).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EBICO.Core\EBICO.Core.csproj" />
    <ProjectReference Include="..\..\src\EBICO.Connector\EBICO.Connector.csproj" />
    <!-- The 'EbicoServer' alias disambiguates the global Program type (EBICO.Server vs. EBICO.Suite)
         in the WebApplicationFactory integration tests; 'global' keeps the normal access. -->
    <ProjectReference Include="..\..\src\EBICO.Server\EBICO.Server.csproj" Aliases="global,EbicoServer" />
    <ProjectReference Include="..\..\src\EBICO.Suite\EBICO.Suite.csproj" />
    <!-- Quickstart sample (#50): the smoke test drives its QuickstartRunner end-to-end. -->
    <ProjectReference Include="..\..\samples\EBICO.Connector.Quickstart\EBICO.Connector.Quickstart.csproj" />
  </ItemGroup>

  <!-- Copy the fixtures (incl. proprietary, non-checked-in sample XML) into the output. -->
  <ItemGroup>
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Vendor captures of real third-party clients (#59): committed and copied into the output so the
         conformance replay finds them next to the test assembly at runtime. -->
    <None Update="Conformance\Vendor\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
