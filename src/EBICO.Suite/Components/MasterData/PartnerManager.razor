@implements IDisposable
@inject IEmulatorStateProvider State
@inject IMasterDataManager Manager
@inject IMasterDataChangeNotifier Changes

@* Interactive island (issue #53): manage partners (customers). A partner is scoped to a bank, so its
   identity is the (HostID, PartnerID) pair (multi-tenant). Listens for master-data changes from the
   sibling islands so the bank dropdown and the table never go stale (issue #126). *@

<section class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2 id="partners-heading">Partners</h2>
        <button class="btn btn-primary btn-sm" id="partner-new" @onclick="BeginCreate" disabled="@(_banks.Count == 0)">New partner</button>
    </div>

    @if (_banks.Count == 0)
    {
        <p class="text-muted"><em>Create a bank first — partners belong to a bank.</em></p>
    }

    @if (_alert is { } alert)
    {
        <div class="alert @alert.Css" role="alert">@alert.Text</div>
    }

    <table class="table">
        <thead>
            <tr><th>HostID</th><th>PartnerID</th><th>Name</th><th class="text-end">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var partner in _partners)
            {
                <tr>
                    <td>@partner.HostId.Value</td>
                    <td>@partner.PartnerId.Value</td>
                    <td>@(partner.Name ?? "—")</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => BeginEdit(partner)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(partner)">Delete</button>
                    </td>
                </tr>
                @if (IsDeleteTarget(partner))
                {
                    <tr class="table-warning">
                        <td colspan="4">
                            Delete partner <strong>@partner.PartnerId.Value</strong> (@partner.HostId.Value)?
                            This <em>cascades</em> and removes all associated subscribers.
                            <button class="btn btn-sm btn-danger ms-2" id="partner-delete-confirm" @onclick="ConfirmDeleteAsync">Delete permanently</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _deleteTarget = null">Cancel</button>
                        </td>
                    </tr>
                }
            }
            @if (_partners.Count == 0)
            {
                <tr><td colspan="4"><em>No partners registered.</em></td></tr>
            }
        </tbody>
    </table>

    @if (_mode is not FormMode.None)
    {
        <div class="card">
            <div class="card-body">
                <h3 class="h5">@(_mode == FormMode.Create ? "Create new partner" : $"Edit partner {_partnerId}")</h3>

                @if (_formError is { } err)
                {
                    <div class="alert alert-warning" role="alert">@err</div>
                }

                <div class="mb-3">
                    <label class="form-label" for="partner-host">Bank (HostID)</label>
                    <select class="form-select" id="partner-host" @bind="_hostId" disabled="@(_mode == FormMode.Edit)">
                        @foreach (var bank in _banks)
                        {
                            <option value="@bank.HostId.Value">@bank.HostId.Value</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="partner-id">PartnerID</label>
                    <input class="form-control" id="partner-id" @bind="_partnerId" disabled="@(_mode == FormMode.Edit)" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="partner-name">Name</label>
                    <input class="form-control" id="partner-name" @bind="_name" />
                </div>

                <button class="btn btn-primary" id="partner-save" @onclick="SaveAsync">Save</button>
                <button class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
            </div>
        </div>
    }
</section>

@code {
    private IReadOnlyList<Bank> _banks = [];
    private IReadOnlyList<Partner> _partners = [];
    private FormMode _mode = FormMode.None;
    private string _hostId = string.Empty;
    private string _partnerId = string.Empty;
    private string _name = string.Empty;
    private (HostId Host, PartnerId Partner)? _deleteTarget;
    private string? _formError;
    private (string Text, string Css)? _alert;

    private IDisposable? _subscription;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _subscription = Changes.Subscribe(OnMasterDataChangedAsync);
        await ReloadAsync();
    }

    /// <inheritdoc />
    public void Dispose() => _subscription?.Dispose();

    // Sorted so the table and the bank dropdown have a stable order (issue #126).
    private async Task ReloadAsync()
    {
        _banks = [.. (await State.GetBanksAsync()).OrderBy(b => b.HostId.Value, StringComparer.Ordinal)];
        _partners =
        [
            .. (await State.GetPartnersAsync())
                .OrderBy(p => p.HostId.Value, StringComparer.Ordinal)
                .ThenBy(p => p.PartnerId.Value, StringComparer.Ordinal),
        ];
    }

    // A sibling island mutated the master data (e.g. a new bank, or a bank deletion that cascaded into
    // this table). Marshal onto this component's renderer before touching state.
    private Task OnMasterDataChangedAsync() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        DropDanglingSelections();
        StateHasChanged();
    });

    // Keeps transient UI state pointing at data that still exists: an open create form must not offer a
    // bank that has just been deleted, and a delete confirmation for a cascaded partner is moot.
    private void DropDanglingSelections()
    {
        if (_deleteTarget is { } t && !_partners.Any(p => p.HostId == t.Host && p.PartnerId == t.Partner))
        {
            _deleteTarget = null;
        }

        if (_mode == FormMode.None)
        {
            return;
        }

        var selectedHostGone = !HostId.TryCreate(_hostId, out var host) || !_banks.Any(b => b.HostId == host);
        if (!selectedHostGone)
        {
            return;
        }

        if (_mode == FormMode.Edit)
        {
            _mode = FormMode.None;
            _alert = ($"Partner {_partnerId} was deleted in the meantime.", "alert-warning");
            return;
        }

        // Create: fall back to a bank that exists rather than posting against a deleted one.
        _hostId = _banks.Count > 0 ? _banks[0].HostId.Value : string.Empty;
        _formError = _banks.Count > 0
            ? "The selected bank was deleted in the meantime — please review the selection."
            : "No bank exists any more.";
    }

    private bool IsDeleteTarget(Partner partner)
        => _deleteTarget is { } t && t.Host == partner.HostId && t.Partner == partner.PartnerId;

    private void BeginCreate()
    {
        _mode = FormMode.Create;
        _hostId = _banks.Count > 0 ? _banks[0].HostId.Value : string.Empty;
        _partnerId = string.Empty;
        _name = string.Empty;
        _formError = null;
        _deleteTarget = null;
    }

    private void BeginEdit(Partner partner)
    {
        _mode = FormMode.Edit;
        _hostId = partner.HostId.Value;
        _partnerId = partner.PartnerId.Value;
        _name = partner.Name ?? string.Empty;
        _formError = null;
        _deleteTarget = null;
    }

    private void Cancel() => _mode = FormMode.None;

    private void AskDelete(Partner partner)
    {
        _deleteTarget = (partner.HostId, partner.PartnerId);
        _mode = FormMode.None;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is { } t)
        {
            await Manager.DeletePartnerAsync(t.Host, t.Partner);
            _alert = ($"Partner {t.Partner.Value} deleted.", "alert-success");
            _deleteTarget = null;
            await ReloadAsync();

            // Cascaded into the partner's subscribers — the subscriber island must drop those rows.
            await Changes.NotifyChangedAsync();
        }
    }

    private async Task SaveAsync()
    {
        _formError = null;

        if (!HostId.TryCreate(_hostId, out var hostId))
        {
            _formError = "Please select a bank.";
            return;
        }

        if (!PartnerId.TryCreate(_partnerId, out var partnerId))
        {
            _formError = "Invalid PartnerID (1–35 characters, only A–Z, a–z, 0–9, ',' or '=').";
            return;
        }

        // SavePartnerAsync is an idempotent upsert (docs/server/master-data.md); the create form must not
        // silently overwrite an existing partner's name (#126).
        if (_mode == FormMode.Create && await Manager.GetPartnerAsync(hostId, partnerId) is not null)
        {
            _formError =
                $"Partner {partnerId.Value} already exists at {hostId.Value} — use 'Edit' to change it.";
            return;
        }

        var name = string.IsNullOrWhiteSpace(_name) ? null : _name.Trim();
        try
        {
            await Manager.SavePartnerAsync(new Partner(hostId, partnerId, name));
        }
        catch (UnknownBankException)
        {
            _formError = $"Bank {hostId.Value} does not exist.";
            return;
        }

        _alert = ($"Partner {partnerId.Value} saved.", "alert-success");
        _mode = FormMode.None;
        await ReloadAsync();

        // A new partner must appear in the subscriber form's partner dropdown without a page reload.
        await Changes.NotifyChangedAsync();
    }
}
