<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- NuGet package metadata (issue #50). Shared fields live in Directory.Build.props. -->
  <PropertyGroup>
    <Description>EBICS client as a NuGet package (mediator pattern): a type-safe onboarding, upload and download API via IEbicsClient.Send for H003/H004/H005. Counterpart to the EBICO server emulator.</Description>
    <PackageTags>ebics;banking;sepa;client;connector;camt;pain;h005</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EBICO.Core\EBICO.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

</Project>
