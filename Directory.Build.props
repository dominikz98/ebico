<Project>

  <!--
    Central, project-wide build conventions for all EBICO projects.
    See docs/development/solution-layout.md for the rationale.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Definition of Done: no new warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!--
      Style rules (IDExxxx) only guide the IDE and do NOT break the build.
      Genuine compiler/analyser warnings are made hard via TreatWarningsAsErrors.
    -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    XML doc is only enforced for the library projects with a public API
    (DoD: "XML-doc comments on public APIs"). Server/Suite are apps,
    not a published API surface; tests need no doc files.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'EBICO.Core' or '$(MSBuildProjectName)' == 'EBICO.Connector'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    NuGet packaging of the published libraries (issue #50). Only EBICO.Core +
    EBICO.Connector are packable; the apps (Server/Suite) and the tests stay unpackable.
    Underlying decision: docs/adr/0024-nuget-packaging-and-versioning.md.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'EBICO.Core' or '$(MSBuildProjectName)' == 'EBICO.Connector'">
    <IsPackable>true</IsPackable>

    <!--
      CalVer {YEAR}.{MONTH}.{BUILD} (deliberately instead of SemVer, see ADR-0024). NuGet/MSBuild
      normalise the components to integers — the month carries no leading zero (2026.07.1 → 2026.7.1).
      In CI, BUILD comes from github.run_number (-p:EbicoBuildNumber=…), locally it defaults to 0.
    -->
    <EbicoBuildNumber Condition="'$(EbicoBuildNumber)' == ''">0</EbicoBuildNumber>
    <VersionPrefix>$([System.DateTime]::UtcNow.Year).$([System.DateTime]::UtcNow.Month).$(EbicoBuildNumber)</VersionPrefix>

    <!-- Package metadata (shared; Description/PackageTags live per project in the .csproj). -->
    <Authors>Dominik Zettl</Authors>
    <Company>tecvia</Company>
    <Copyright>© $([System.DateTime]::UtcNow.Year) tecvia</Copyright>
    <PackageProjectUrl>https://github.com/dominikz98/ebico</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dominikz98/ebico</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols (snupkg) + SourceLink: debugging right into the sources of the respective commit. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'EBICO.Core' or '$(MSBuildProjectName)' == 'EBICO.Connector'">
    <!-- A deterministic source_link.json into the packages (version centrally in Directory.Packages.props). -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
