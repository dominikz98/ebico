<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- A sample, not a published artefact. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The quickstart hosts the EBICO.Server in-process (Kestrel) so that it runs without an
    external server. For that the console app needs the ASP.NET Core shared framework
    (WebApplication); ProjectReferences do not flow the FrameworkReference automatically.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EBICO.Connector\EBICO.Connector.csproj" />
    <ProjectReference Include="..\..\src\EBICO.Server\EBICO.Server.csproj" />
    <ProjectReference Include="..\..\src\EBICO.Core\EBICO.Core.csproj" />
  </ItemGroup>

</Project>
